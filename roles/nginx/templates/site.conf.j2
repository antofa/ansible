server {
    listen 80;
    server_name {{ domain }} {{ domain_www }};

    root /var/www/{{ domain }}/html;
    index index.html;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type "text/plain";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
